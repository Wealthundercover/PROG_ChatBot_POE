<Window x:Class="CybersecurityChatbotGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CybersecurityChatbotGUI"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="#F4F6F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1E293B" Padding="15,0">
            <TextBlock Text="🔒 Cybersecurity Awareness Assistant" 
                   Foreground="White" 
                   FontSize="18" 
                   FontWeight="Bold" 
                   VerticalAlignment="Center"/>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="10" VerticalScrollBarVisibility="Auto">
            <TextBox x:Name="txtChatHistory" 
                 IsReadOnly="True" 
                 TextWrapping="Wrap" 
                 Background="White" 
                 BorderBrush="#CBD5E1"
                 Padding="10" 
                 FontSize="14"
                 FontFamily="Consolas"
                 Text="System: Welcome to your Cybersecurity Assistant! App initialized...&#x0a;"/>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="txtUserInput" 
                 Grid.Column="0" 
                 Padding="8,5" 
                 FontSize="14" 
                 VerticalContentAlignment="Center"
                 BorderBrush="#CBD5E1"
                 Margin="0,0,10,0"/>

            <Button x:Name="btnSend" 
        Grid.Column="1" 
        Content="Send" 
        Background="#2563EB" 
        Foreground="White" 
        FontWeight="Bold" 
        FontSize="14"
        Click="btnSend_Click"/>
        </Grid>
    </Grid>
</Window>
